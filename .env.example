# ==============================================================================
# AWS Route 53 Clone - Root Environment Variables Example
# Copy this file to .env (or respective .env files in frontend/ and backend/)
# ==============================================================================

# Backend Configuration
PROJECT_NAME="AWS Route 53 Clone API"
API_V1_STR="/api/v1"
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite Database
DATABASE_URL=sqlite:///./route53.db

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
